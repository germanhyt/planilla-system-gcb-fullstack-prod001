# Copiar a .env y completar. NO commitear .env (contiene secretos).
# Generar secretos:  openssl rand -base64 48   (o: python -c "import secrets;print(secrets.token_urlsafe(48))")

# --- Base de datos ---
DB_PASSWORD=

# --- API ---
JWT_SECRET=
# Solo para la semilla demo (dev). En prod no se usa (AUTO_SEED=0).
SEED_PASSWORD=
# 1 = instala requirements-dev (dev). En prod docker-compose.prod.yml fuerza 0.
DEV=1

# --- Prod: nginx_proxy + acme-companion ---
# Dominio de producción (registro A hacia el servidor antes de levantar) y correo del certificado Let's Encrypt
WEB_HOST=planilla.gcb.pe
LETSENCRYPT_EMAIL=sistemas@gcb.pe
# Nombre de la red docker externa del nginx_proxy
PROXY_NETWORK=nginx-proxy

# --- Backups (scripts/backup-db.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# TODO(PENDIENTE PO): destino de copia FUERA del servidor aún no decidido (S3/Backblaze/Drive/otro servidor).
# Placeholder: no se usa todavía; los scripts solo dejan los dumps en BACKUP_DIR.
BACKUP_OFFSITE_DEST=PENDIENTE_DEFINIR
