# Copiar a .env y completar. NO commitear .env (contiene secretos).
# Generar secretos:  openssl rand -base64 48   (o: python -c "import secrets;print(secrets.token_urlsafe(48))")

# --- Base de datos ---
DB_PASSWORD=

# --- API ---
JWT_SECRET=
# Solo para la semilla demo (dev). En prod no se usa (AUTO_SEED=0).
SEED_PASSWORD=
# 1 = instala requirements-dev (dev). En prod docker-compose.prod.yml fuerza 0.
DEV=1

# --- Prod: nginx_proxy + acme-companion ---
WEB_HOST=planilla.example.com
LETSENCRYPT_EMAIL=ti@example.com
# Nombre de la red docker externa del nginx_proxy
PROXY_NETWORK=nginx-proxy

# --- Backups (scripts/backup-db.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
